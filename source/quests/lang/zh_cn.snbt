	]
	quest.7BED63639BA10A4C.title: "FAQ"
	quest.7C2992F5EDAF3620.title: "百炼成馔"
	quest.7C349A4B201E6EC7.quest_desc: ["&6简易的磨粉机&r，可能会有&6副产物&r，&b无限粉块&r磨粉后可以借此增产。多余的&6无限粉&r可以拿来发电"]
	quest.7C445C2D5C60544A.quest_desc: [
		"通过&b粉碎工厂&r可以使用&6末地石&r更方便地制作&b末影化合物&r。&6末地石&r则可通过&6刷石机&r刷取。"
		""
		"部分矿物经过粉碎也会有&6副产物矿&r产出。"
	]
	quest.7C45F51C9E1EF8F3.title: "油"
	quest.7CD5DE755A53C1DB.quest_desc: ["佩戴&b天使指环&r可以&6无条件&r实现创造飞行"]
	quest.7CD5DE755A53C1DB.title: "农业专家"
	quest.7CE3341F012F71E2.title: "下界及末地肉类"
	quest.7D3F7052A7264CE4.title: "茄子"
	quest.7D617D177844F994.quest_desc: ["记录一些机械动力的机器及产线"]
	quest.7D617D177844F994.title: "&b机械动力"
	quest.7D81A421F7021179.title: "氯"
	quest.7DC47FAE9D4025EF.quest_desc: [
		"装备一些&b饰品&r可以增强能力。"
		""
		"如&b掘地之爪&r可将装备者的挖掘等级提升为&6石质&r。"
	]
	quest.7DC47FAE9D4025EF.title: "饰品"
	quest.7DD16BA3275EC3DE.quest_desc: ["高级设备，具备多种实用配方，简化了很多原有配方，亦可将&6物质球转化为奇点&r作为后期工业材料"]
	quest.7DF7E1DEA8A8A3FC.quest_desc: [
		"在&6极光宫殿&r探索获得。虽然攻击力不俗，但耐久很低。"
		""
		"被攻击的生物会获得&6冻结&r效果"
	]
	quest.7E071FA2242E44BD.quest_desc: ["有机食物的重要组成部分，可溶解&6有机物&r获得"]
	quest.7E61267C5D2BCB16.title: "奖励一览"
	quest.7E6163D636BF2C62.quest_desc: ["&b姬子&r：这个世界同样有&b信标&r，激活后或许&6信标&r可以发出&6能被列车接收到的信号&r"]
	quest.7E6163D636BF2C62.title: "&6姬子的建议"
	quest.7E96AA062AD426AE.quest_desc: ["我黑椒酱呢"]
	quest.7F19A1A1402F9378.quest_desc: ["手持&6燧石&r右键&6纯种鸡&r即可得到。"]
	quest.7F3AB49D6DC13C1B.quest_desc: [
		"&b原子锻造器&r是一种用于制造&6高级工业配件&r、&6辅助倍矿处理&r或代替部分&6冶金灌注加工&r的机器。"
		""
		"&6硅晶圆、&r&b海森堡补偿器、高级计算引擎、超级AI芯片&r都需要通过&6原子锻造器&r&b蚀刻&r获得"
		""
		"&6能量线缆&r无法直接连接到&6原子锻造器&r;它需要由&b目标标识器&r绑定&b末影激光器&r供能。"
	]
	quest.7F5D223553FEF566.quest_desc: ["击杀&650个掠夺者&r获得"]
	quest.7F674CFE695EFE33.quest_desc: ["提高机器的&6能源利用率&r和&6存电能力&r"]
	quest.7F69F3A1EACBCC5A.quest_desc: ["第一道工序"]
	quest.7F69F3A1EACBCC5A.quest_subtitle: "自动化的开端"
	quest.7F6CF8588FC6C718.quest_desc: [
		"&e大功告成！&r"
		""
		"不过我发现，其实&6酿造台&r还能酿造一些&6强力的药水&r，有机会可以试一试。"
	]
	quest.7F7E071B0F23A888.quest_desc: [
		"本模组的&6任意合金&r右键线缆可以升级与其连接的最近&6 8 个线缆&r的等级"
		""
		"也就是说，当机器已经连接线缆时，&6不必拆下后再合成&r。"
		""
		"线缆的&6连接处&r可以通过&b配置工具&r(配置模式)&bShift +右键&r改变模式："
		""
		"分为&6无、输入、抽出、正常&r四种模式，对应的管道连接处会有一定变化，可以借此隔离管道。"
		""
		"直接右键能调&6是否受红石控制&r。"
		""
		"线缆的中段可以使用&b配置工具&r&6改变颜色&r，不同颜色不相连。在连接容器的一段标上颜色可用&b物流整理机&r指定颜色分类放置"
	]
	quest.7F7E071B0F23A888.quest_subtitle: "传输能量"
	quest.7FAA4AA67EEAEA0C.quest_desc: [
		"附近应该有一些树...用&6斧头&r破坏它们，用&b~&r键&6一次性破坏整棵树&r。一棵大树能一次收获很多&6原木&r。"
		""
		"它们可以在&6物品栏&r(&6背包右上角2*2&r的格子)中合成&b木板&r"
		"{image:minecraft:textures/gui/container/inventory.png width:100 height:100 align:center fit:true click_action:none:}"
	]
	quest.7FAA4AA67EEAEA0C.title: "认识世界"
	quest.7FB1B9761F75702D.quest_desc: [
		"&6Allthemodium 矿石&r是 &bATM 系列&r提供的第 1 级矿石，此矿石只能被玩家使用&6下界合金及以上&r的挖掘等级的镐手动挖掘"
		""
		"在主世界&b深暗之域&r生物群系地下洞穴表面露出的岩石、&b采矿维度&r深板岩层、&b异界&r深板岩层均有生成，采矿维度的生成量相对最多。"
	]
	quest.7FE4BFF42DF45F7B.quest_desc: [
		"用&6剪刀剪下草&r可以在&6熔炉&r中烧制成&b草秆&r，而&6斧头&r在&6砧板&r可以削下&6原木&r的&b树皮&r"
		""
		"放置后的&6有机堆肥&r会在一段时间后会转变为&b沃土&r。"
		""
		"&6沃土耕地&r上的作物长得更快。"
	]
	quest.7FEEDA36CB259B09.quest_desc: [
		"&b巨魔洞窟&r中有多处&6小型黑曜石房间&r，在其内部的箱子里可以找到&b魔豆&r，种植在&b肥沃泥土&r上会长出&6通天豆茎&r到达&b云上小屋&r。。"
		""
		"洞窟中央有一座&6巨大的黑曜石房间&r，使用在&6云上小屋&r获得的&b巨人镐&r挖开后，即可获得&b余烬之灯&r，烧尽沿途的荆棘"
	]
