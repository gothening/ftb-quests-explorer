		""
		"&6钚&r &b1000mB&r            1 &6中子素锭&r"
		"&6钋&r &b1000mB&r            1 &6中子素锭&r"
		"&6反物质&r &b1mB&r            1 &6中子素块&r"
		"&6核废料&r &b2000mB&r       1 &6中子粉尘&r"
		"&6耗尽核废料&r &b5000mB&r   1 &6中子素粒&r"
		"&6氘&r &b10000mB&r          1 &6中子素尘埃&r"
		"&6聚变燃料&r &b10000mB&r   2 &6中子素尘埃&r"
		"&6氚&r &b10000mB&r          1 &6中子素尘埃&r"
		""
