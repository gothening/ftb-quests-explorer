	quest.65445032CF2B5938.title: "氧"
	quest.654A6D1B646AB054.quest_desc: ["由&6余烬面粉&r制作，用于制作&b烈焰蛋糕&r"]
	quest.656D017F942E81B9.quest_desc: ["手持&6末地石&r右键&6纯种鸡&r即可得到。"]
	quest.65F4122ABFE7D71B.quest_desc: ["恭喜&6刷石机&r可以撑地了"]
	quest.662CCE223014763B.quest_desc: ["这个倒是嚼的动"]
	quest.6664440818232493.quest_desc: ["椒椒椒，椒椒椒椒！"]
	quest.669304A7F0D0FA7F.quest_desc: [
		"哈？你问我为什么&6浣熊&r是你的同类？"
		""
		"传说银河中有位&b银河球棒侠&r，正是以&6浣熊&r为形象。"
		""
		"而你曾经拿着&6球棒&r，一度称霸寰宇，于是被人认成了那只&6球棒浣熊&r。"
	]
	quest.669304A7F0D0FA7F.quest_subtitle: "干脆面之作"
	quest.669304A7F0D0FA7F.title: "寻找你的同类"
	quest.6713024341F8DFD5.quest_desc: [
		"&b月相罗盘&r只能在&2幽灵森林&r的&6墓地&r中找到，其作用类似于时钟。"
		""
		"不会显示昼夜周期，而是显示月亮周期的八个不同阶段。当将鼠标悬停在物品上面时，将以文本形式显示月亮当前的月相。"
	]
