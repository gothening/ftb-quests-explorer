	quest.5C38B572AFE06070.quest_desc: ["燃烧&6石油或柴油等流体燃料&r来产出大量能量的机器。"]
	quest.5C643A465D3DFC98.quest_subtitle: "粉碎&6花岗岩&r获得&6红沙"
	quest.5C99972856E89260.quest_desc: ["强力的&d模块化装备&r"]
	quest.5CD153FB51DDA626.quest_desc: [
		"再记一遍boss和对应结构："
		"{image:twilightforest:textures/map/decorations/naga_courtyard.png width:40 height:40 align:center}"
		"&b娜迦庭院&r-&b娜迦&r"
		"{image:twilightforest:textures/map/decorations/lich_tower.png width:40 height:40 align:center click_action:none:}"
		"&b巫妖怪塔&r-&b暮光巫妖"
