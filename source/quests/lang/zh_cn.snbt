	quest.32C168D4D36FB24D.quest_desc: ["可控、稳定量产&d闪电&r的核心设备。不依赖天气，通过消耗&bFE能量&r与&6材料&r主动产出&d闪电&r。"]
	quest.32DC132E263BF955.quest_desc: [
