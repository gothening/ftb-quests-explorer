	quest.1D9CFBEABF64AE11.quest_desc: ["用于连接&bAE2&r的机器组成网络，最多连接&68个频道&r"]
	quest.1DB9951D21A071B4.quest_desc: ["&6打点好行装&r后，我想我可以去&6征战四方&r了，第一站就定为&b试炼密室&r吧。它是一个包含&b试炼刷怪笼&r和&b宝库&r的地下结构。"]
	quest.1DB9951D21A071B4.quest_subtitle: "指南针 搜索【试炼密室】即可"
