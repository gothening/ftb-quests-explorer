	quest.24BA60D8DF628699.quest_desc: [
		"&b扳手&r的作用倒是不言而喻，而&b工程师护目镜&r可以用来查看机械动力元件的各项数据："
		""
		"查&6看动力元件应力消耗&r数，即应力影响；"
		""
		"查看&6动力源应力产出&r数，即应力量；"
		""
		"查看&6溜槽&r和&6隧道&r内的物品；"
		""
		"查看流体元件中&6流体&r的具体信息。"
	]
	quest.24BA60D8DF628699.title: "扳手与护目镜"
