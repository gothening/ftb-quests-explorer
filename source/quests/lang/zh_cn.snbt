	]
	quest.1DCD1935301C020D.quest_desc: [
		""
		"&b铸造器&r专门用于制作各种合金。一旦&6能源和矿石供应稳定&r，&6铸造器&r制作&6进阶合金&r会更加便捷和节省材料，如制作&6下界合金、钢、精镍、辐镍金&r"
	]
	quest.1DD25F95B6BCCF77.quest_subtitle: "辐照&6锔&r获得"
	quest.1DD97991148045DE.quest_desc: [
