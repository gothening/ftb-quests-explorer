	quest.5060DE6A9381967E.title: "资源传输"
	quest.50794173FEACDE53.quest_desc: [
		"将任意一个&b被附魔的物品&r和一本&6书&r放在一个&b砂轮&r里，&6砂轮&r会将物品的&6全部魔咒&r转移至&6书&r上。"
		""
		"将一本&b附魔书&r和一本&6普通书&r放在&6砂轮&r里，&6砂轮&r会将附魔书中&6第一行&r的附魔转移至&6书&r上。"
	]
	quest.50C9631573DF4C91.title: "芹菜"
	quest.50E0D61793BAEE9E.quest_desc: ["&b银狼&r：这条是我加的，实在是不想你每次想搞点&6烈焰粉&r都要去折腾&6烈焰人&r。不过&6烈焰棒&r还得你亲力亲为"]
	quest.50E0D61793BAEE9E.quest_subtitle: "粉碎&6岩浆膏&r获得&6烈焰粉&r"
