	quest.1631AD10D929D98E.title: "远古城市"
	quest.16689EF35758E854.quest_desc: [""]
	quest.16689EF35758E854.quest_subtitle: "电解&6水&r获得"
	quest.16689EF35758E854.title: "氢"
	quest.166FF86FEFFEEE42.quest_desc: ["&b5倍矿产线&r的全部材料，只需要在&6化学压射器&r前添加&b溶解、清洗、结晶&r工序并引入&6硫处理&r产线即可"]
	quest.16E99FBC1C199E44.title: "机械管道"
	quest.1754C5BD8ECA7C81.quest_desc: [""]
	quest.1754C5BD8ECA7C81.quest_subtitle: "&6核废料&r转化获得"
	quest.1758A5773C014ADE.quest_desc: ["通过&6溶解与化合&r再造万物的机器，造价不菲，但功能强悍，尤其是可以用&6骨粉&r再造&b骷髅头颅&r。"]
	quest.1763F5AB4D647A7D.quest_desc: [""]
	quest.1763F5AB4D647A7D.quest_subtitle: "不会清除已有的幻翼"
	quest.1763F5AB4D647A7D.title: "禁止幻翼生成"
	quest.17704C87DDCE93D1.quest_desc: [
		"一个&6小助手&r，右击&b充电台&r才能生成,并将其作为&6母站&r。"
		""
		"内置&6工作台、熔炉、箱子、铁砧&r的工具，并可以&6自动跟随和拾取物品&r。"
	]
	quest.17E45D0AF2E41C85.quest_desc: ["通过&b镅&r辐射转化为&b锎&r这一中子活化源之后，便可以制作&b电力中子活化器&r摆脱&6太阳能中子活化&r"]
	quest.17E47CF1DC3748B4.quest_desc: [
		"&b绿宝石&r是村民交易的&6主要货币&r。&6交易&r也是获取&6绿宝石&r的重要来源。"
		""
		"对应村民职业售卖对应物品，但似乎要相应&6工作方块&r才能激活。（可再绿宝石用途页查询）"
		""
		"值得注意的是，在开拓时还会遇到&b流浪商人&r，它们会售卖一些&6稀有的玩意儿&r，有的倒也&6值得一看&r。"
	]
	quest.17E47CF1DC3748B4.title: "村民的职业"
	quest.1827B120ABED45FD.quest_desc: [
		"&6水碰到岩浆&r就会变成&b石头&r，可以利用这一点&6无限获取石头&r，包括&6岩石类矿物&r。"
		""
		"只要&6把水和岩浆&r放在这个装置两边，装置就会产生&b圆石&r，&6在上面放置容器&r就可以存储了，&6更高级的材料&r可以制作&6更高级的刷石机&r。"
	]
	quest.186D1F43F6B772E3.quest_desc: [
		"&b雪原&r放眼望去几乎只能看到雪。"
		""
		"这里&6不会下雨&r，只会下雪。湖泊与河流都会结冰。"
	]
	quest.186D1F43F6B772E3.quest_subtitle: "雪~花飘飘~"
	quest.186D1F43F6B772E3.title: "雪原"
	quest.188423D62C44B63D.quest_desc: [
		"将&6赛特斯石英水晶&r放在&b充能器&r上并为其供电，即可将其转化&b充能赛特斯石英水晶&r，后者可以再被加工为&b磨制玫瑰石英&r作为工业原料。"
		""
		"&6紫水晶&r在充能器也可被加工为&b辐水晶&r"
		""
		"&6充能赛特斯石英水晶&r和&6部分矿物粉末&r一起丢入水中会发生反应并生成&62份的矿物&r。如果能加以利用也不失为一种&6资源获取手段&r。"
	]
	quest.18940A55C1B6AE47.quest_desc: [""]
	quest.18D204B99C850153.quest_desc: ["&b粉碎机&r除了也可以&6将圆石粉碎为沙砾&r外，能进行许多更精细的粉碎加工。其中&b生物燃料&r是&6粉碎植物&r的结果，可以作为&l&e发电机燃料&r&r，也还有很多的用途."]
	quest.18D204B99C850153.title: "粉碎机"
	quest.1950641C3564CD8A.quest_desc: ["驯服一匹马之后，可以为其穿上&6马铠&r来增加其防御力"]
	quest.197DE26F7C31AA7E.quest_desc: [
		"&b丹恒&r：看起来，这个世界并非和我们所在的宇宙全无联系。这些宝石或许&6能打造一些趁手的兵器&r。"
		""
		"它们在地下与矿物无异，要&6注意分辨&r"
	]
	quest.197DE26F7C31AA7E.quest_subtitle: "异世界的力量"
	quest.1984AF45011F278F.quest_desc: [""]
	quest.1984AF45011F278F.quest_subtitle: "&6花岗岩&r的成分之一"
	quest.19A1243D173C9C97.quest_desc: [""]
